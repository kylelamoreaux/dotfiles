set number          " Turn on line numbers
set syntax=on       " Enable standard text color formatting
set tabstop=4       " Show tabs as 4 spaces wide
set shiftwidth=4    " Use 4 spaces for auto-indentation
set expandtab       " Convert the Tab key straight into spaces
set softtabstop=4   " Show tabs as 4 spaces wide while editing
set autoindent      " Copy indent from current line when starting a new line